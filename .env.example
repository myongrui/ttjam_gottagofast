# Copy to .env and fill in. .env is gitignored; .env.example is not.
OPENAI_API_KEY=sk-...
# Verify the exact id against /v1/models before trusting it (see README/LOOP.md)
OPENAI_MODEL=gpt-5.3-codex
# Reasoning effort, if the model supports it. Omit to use the model default.
# Supported: none, minimal, low, medium, high, xhigh
# Higher effort writes better kernels but costs more output tokens per candidate.
# OPENAI_REASONING_EFFORT=high
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: lets autoloop --stop-pod halt the GPU when the loop exits.
# Create at https://console.runpod.io/user/settings
RUNPOD_API_KEY=rpa_...
RUNPOD_POD_ID=h9qpy3lmrt8be6
